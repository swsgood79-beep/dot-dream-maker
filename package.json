{
  "name": "dot-dream-maker",
  "private": true,
  "version": "0.29.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "build:single": "tsc -b && vite build --mode single",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs",
    "balance": "vite-node scripts/balance-sim.ts 20",
    "sprites": "python3 scripts/build-sprites.py && python3 scripts/build-furniture.py"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "galmuri": "^2.40.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
